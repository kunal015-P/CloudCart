
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'RUN_E2E',
            defaultValue: false,
            description: 'Run E2E tests. WARNING: current E2E tests modify the live database.'
        )
    }

    environment {
        // CI-only values. Never use these for production deployment.
        POSTGRES_DB = 'cloudcart_ci'
        POSTGRES_USER = 'cloudcart_ci'
        POSTGRES_PASSWORD = 'ci-placeholder-password'

        DATABASE_URL = 'postgresql://cloudcart_ci:ci-placeholder-password@postgres:5432/cloudcart_ci'
        REDIS_URL = 'redis://redis:6379/0'
        JWT_SECRET = 'cloudcart-ci-placeholder-secret'
        JWT_ALGORITHM = 'HS256'
        JWT_EXPIRE_MINUTES = '60'

        USER_SERVICE_URL = 'http://user-service:8001'
        PRODUCT_SERVICE_URL = 'http://product-service:8002'
        CART_SERVICE_URL = 'http://cart-service:8003'
        ORDER_SERVICE_URL = 'http://order-service:8004'
        AI_SERVICE_URL = 'http://ai-service:8005'

        CORS_ORIGINS = 'http://localhost:80'

        // Docker Hub configuration
        DOCKERHUB_NAMESPACE = 'kunal161'

        // Existing application directory on Jenkins EC2
        DEPLOY_DIR = '/home/ec2-user/CloudCart/cloudcart-app'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()
                }

                echo "Checked out CloudCart commit: ${env.GIT_SHA}"
            }
        }

        stage('Validate Docker Compose') {
            steps {
                dir('cloudcart-app') {
                    sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    echo "Validating Docker Compose configuration..."

                    docker compose config --quiet

                    echo "Docker Compose configuration is valid."
                    '''
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                dir('cloudcart-app') {
                    sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    echo "Building six CloudCart application images..."

                    # Compose image names use IMAGE_TAG.
                    # Build directly with this Git commit's tag.
                    IMAGE_TAG="$GIT_SHA" docker compose build

                    echo "All six application images built successfully."
                    '''
                }
            }
        }

        stage('Verify Running Application') {
            steps {
                sh '''#!/usr/bin/env bash
                set -euo pipefail

                echo "Checking current CloudCart application health..."

                curl --fail --silent --show-error \
                    http://127.0.0.1/api/products/health

                echo ""
                echo "CloudCart application is healthy."
                '''
            }
        }

        stage('Install Test Dependencies') {
            steps {
                dir('cloudcart-app') {
                    sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    python3 -m venv .venv-ci

                    .venv-ci/bin/pip install \
                        -r tests/requirements-test.txt

                    mkdir -p reports
                    '''
                }
            }
        }

        stage('Integration Tests') {
            steps {
                dir('cloudcart-app') {
                    sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    echo "Running CloudCart integration tests..."

                    .venv-ci/bin/pytest \
                        -c tests/pytest.ini \
                        -m integration \
                        tests/ \
                        --junitxml=reports/integration-tests.xml

                    echo "Integration tests passed."
                    '''
                }
            }
        }

        stage('End-to-End Tests') {
            when {
                expression {
                    return params.RUN_E2E
                }
            }

            steps {
                dir('cloudcart-app') {
                    sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    echo "Running explicitly requested E2E tests..."

                    .venv-ci/bin/pytest \
                        -c tests/pytest.ini \
                        -m e2e \
                        tests/ \
                        --junitxml=reports/e2e-tests.xml

                    echo "E2E tests passed."
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('cloudcart-app') {
                    script {
                        def scannerHome = tool 'SonarScanner'

                        withSonarQubeEnv('SonarQube-Server') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner
                            """
                        }
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qualityGate = waitForQualityGate()

                        echo "SonarQube Quality Gate: ${qualityGate.status}"

                        if (qualityGate.status != 'OK') {
                            error "SonarQube Quality Gate failed: ${qualityGate.status}"
                        }

                        echo 'SonarQube Quality Gate passed!'
                    }
                }
            }
        }

        stage('Login and Push Images to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    set +x

                    echo "Checking Docker Hub credentials..."

                    if [[ "$DOCKERHUB_USERNAME" != "$DOCKERHUB_NAMESPACE" ]]; then
                        echo "ERROR: Docker Hub credential username does not match the configured namespace."
                        exit 1
                    fi

                    echo "Logging in to Docker Hub..."

                    echo "$DOCKERHUB_TOKEN" | docker login \
                        --username "$DOCKERHUB_USERNAME" \
                        --password-stdin

                    # Always log out, including if a push fails.
                    trap 'docker logout >/dev/null 2>&1 || true' EXIT

                    services=(
                        user-service
                        product-service
                        cart-service
                        order-service
                        ai-service
                        frontend
                    )

                    echo "Publishing CloudCart commit: $GIT_SHA"

                    for service in "${services[@]}"; do

                        repository="$DOCKERHUB_NAMESPACE/cloudcart-$service"

                        commit_image="$repository:$GIT_SHA"
                        latest_image="$repository:latest"

                        echo "----------------------------------------"
                        echo "Publishing $service"
                        echo "Repository: $repository"
                        echo "----------------------------------------"

                        # Confirm the locally built commit image exists.
                        docker image inspect "$commit_image" >/dev/null

                        # Push the immutable commit-specific image.
                        docker push "$commit_image"

                        # Create and publish the latest tag.
                        docker tag "$commit_image" "$latest_image"

                        docker push "$latest_image"

                        echo "Successfully published $repository"
                    done

                    echo "All six CloudCart images published successfully."
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Publishing available test reports...'

            junit(
                allowEmptyResults: true,
                testResults: 'cloudcart-app/reports/*.xml'
            )
        }

        success {
            echo """
                =========================================
                CLOUDCART CI PIPELINE SUCCESSFUL!
                =========================================

                Git Commit: ${env.GIT_SHA}

                Published Docker Hub images:

                ${env.DOCKERHUB_NAMESPACE}/cloudcart-user-service:${env.GIT_SHA}
                ${env.DOCKERHUB_NAMESPACE}/cloudcart-product-service:${env.GIT_SHA}
                ${env.DOCKERHUB_NAMESPACE}/cloudcart-cart-service:${env.GIT_SHA}
                ${env.DOCKERHUB_NAMESPACE}/cloudcart-order-service:${env.GIT_SHA}
                ${env.DOCKERHUB_NAMESPACE}/cloudcart-ai-service:${env.GIT_SHA}
                ${env.DOCKERHUB_NAMESPACE}/cloudcart-frontend:${env.GIT_SHA}

                All six latest tags have also been updated.

                No EC2 deployment was performed.
                No AWS ECR operations were performed.

                =========================================
            """
        }

        failure {
            echo """
                =========================================
                CLOUDCART CI PIPELINE FAILED!
                =========================================

                Git Commit: ${env.GIT_SHA}

                Check the Jenkins console output
                to identify the failed stage.

                =========================================
            """
        }
    }
}
