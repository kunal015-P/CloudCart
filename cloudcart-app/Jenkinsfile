
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    // These are dummy CI values for Compose validation/build only.
    // They are NOT production credentials.
    environment {
        POSTGRES_DB = 'cloudcart_ci'
        POSTGRES_USER = 'cloudcart_ci'
        POSTGRES_PASSWORD = 'ci-placeholder-password'
        DATABASE_URL = 'postgresql+psycopg://cloudcart_ci:ci-placeholder-password@postgres:5432/cloudcart_ci'

        REDIS_URL = 'redis://redis:6379/0'
        JWT_SECRET = 'ci-placeholder-secret-not-for-deployment'
        JWT_ALGORITHM = 'HS256'
        JWT_EXPIRE_MINUTES = '60'

        PRODUCT_SERVICE_URL = 'http://product-service:8002'
        USER_SERVICE_URL = 'http://user-service:8001'
        CART_SERVICE_URL = 'http://cart-service:8003'
        ORDER_SERVICE_URL = 'http://order-service:8004'
        AI_SERVICE_URL = 'http://ai-service:8005'

        CORS_ORIGINS = 'http://localhost:3000'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out CloudCart source code'
                checkout scm
            }
        }

        stage('Validate Docker Compose') {
            steps {
                dir('cloudcart-app') {
                    sh 'docker compose config --quiet'
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                dir('cloudcart-app') {
                    sh '''
                        set -e

                        for service in user-service product-service cart-service order-service ai-service frontend
                        do
                            echo "Building Docker image: $service"
                            docker compose build "$service"
                        done
                    '''
                }
            }
        }

        stage('Verify Running Application') {
            steps {
                sh '''
                    echo "Checking CloudCart Product API..."

                    curl --fail \
                         --silent \
                         --show-error \
                         --retry 10 \
                         --retry-connrefused \
                         --retry-delay 3 \
                         --max-time 5 \
                         http://127.0.0.1/api/products/health

                    echo "CloudCart is reachable!"
                '''
            }
        }

        stage('Install Test Dependencies') {
            steps {
                dir('cloudcart-app') {
                    sh '''
                        set -e

                        python3 -m venv .venv-ci

                        .venv-ci/bin/python -m pip install \
                            --disable-pip-version-check \
                            -r tests/requirements-test.txt
                    '''
                }
            }
        }

        stage('Integration Tests') {
            steps {
                dir('cloudcart-app') {
                    sh '''
                        set -e

                        mkdir -p reports

                        .venv-ci/bin/python -m pytest \
                            -c tests/pytest.ini \
                            -m integration \
                            tests/ \
                            --junitxml=reports/integration.xml
                    '''
                }
            }
        }

        stage('End-to-End Tests') {
            steps {
                dir('cloudcart-app') {
                    sh '''
                        set -e

                        mkdir -p reports

                        .venv-ci/bin/python -m pytest \
                            -c tests/pytest.ini \
                            -m e2e \
                            tests/ \
                            --junitxml=reports/e2e.xml
                    '''
                }
            }
        }
    }

        
stage('SonarQube Analysis') {
    steps {
        dir('cloudcart-app') {
            script {
                def scannerHome = tool 'SonarScanner'

                withSonarQubeEnv('SonarQube-Server') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }
            }
        }
    }
}

stage('SonarQube Analysis') {
    steps {
        dir('cloudcart-app') {
            script {
                def scannerHome = tool 'SonarScanner'

                withSonarQubeEnv('SonarQube-Server') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }
            }
        }
    }
}

stage('SonarQube Analysis') {
    steps {
        dir('cloudcart-app') {
            script {
                def scannerHome = tool 'SonarScanner'

                withSonarQubeEnv('SonarQube-Server') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }
            }
        }
    }
}

stage('SonarQube Analysis') {
    steps {
        dir('cloudcart-app') {
            script {
                def scannerHome = tool 'SonarScanner'

                withSonarQubeEnv('SonarQube-Server') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }
            }
        }
    }
}


stage('SonarQube Analysis') {
    steps {
        dir('cloudcart-app') {
            script {
                def scannerHome = tool 'SonarScanner'

                withSonarQubeEnv('SonarQube-Server') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }
            }
        }
    }
}

stage('SonarQube Analysis') {
    steps {
        dir('cloudcart-app') {
            script {
                def scannerHome = tool 'SonarScanner'

                withSonarQubeEnv('SonarQube-Server') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }
            }
        }
    }
}

stage('SonarQube Analysis') {
    steps {
        dir('cloudcart-app') {
            script {
                def scannerHome = tool 'SonarScanner'


                withSonarQubeEnv('SonarQube-Server') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }
            }
        }
    }
}

    post {
        always {
            junit(
                testResults: 'cloudcart-app/reports/*.xml',
                allowEmptyResults: true
            )

            echo 'CloudCart CI pipeline execution finished.'
        }

        success {
            echo 'All CloudCart CI stages completed successfully!'
        }

        failure {
            echo 'CloudCart CI failed. Check the console output.'
        }
    }
}
